---
import "@fontsource/ibm-plex-sans/400.css";
import "@fontsource/ibm-plex-sans/500.css";
import "@fontsource/ibm-plex-sans/600.css";
import "@fontsource/ibm-plex-mono/400.css";
import "../styles/global.css";

import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { type Lang, t } from "../i18n/ui";

type Props = {
  lang: Lang;
  title?: string;
  description?: string;
  /** Path of the same page without the language prefix, for the language switch and hreflang. */
  path?: string;
  wide?: boolean;
};

const { lang, title = t(lang, "meta.title"), description = t(lang, "meta.description"), path = "" } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const site = Astro.site ? Astro.site.origin : "";
const urlFor = (l: Lang) => `${site}${base}${l === "tr" ? "" : "/en"}/${path}`;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#F7F6F3" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#141413" media="(prefers-color-scheme: dark)" />
    <link rel="icon" href={`${base}/favicon.svg`} type="image/svg+xml" />
    <link rel="canonical" href={urlFor(lang)} />
    <link rel="alternate" hreflang="tr" href={urlFor("tr")} />
    <link rel="alternate" hreflang="en" href={urlFor("en")} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={urlFor(lang)} />
    <meta property="og:locale" content={lang === "tr" ? "tr_TR" : "en_US"} />
  </head>
  <body>
    <a class="skip-link" href="#main">{t(lang, "nav.skip")}</a>
    <Header lang={lang} path={path} />
    <main id="main">
      <slot />
    </main>
    <Footer lang={lang} />
  </body>
</html>
