---
import { href, type Lang, t } from "../i18n/ui";

const { lang } = Astro.props as { lang: Lang };
---

<section class="hero container" aria-labelledby="hero-title">
  <p class="role">{t(lang, "hero.role")} · Samsun</p>
  <h1 id="hero-title">Berat Oğuzhan Turğut</h1>
  <p class="intro">{t(lang, "hero.intro")}</p>
  <ul class="stats" aria-label={lang === "tr" ? "Kısaca" : "In short"}>
    {t(lang, "hero.stats").map((item) => <li>{item}</li>)}
  </ul>
  <p class="open">{t(lang, "hero.open")}</p>
  <div class="actions">
    <a class="button button--primary" href="#projects">{t(lang, "hero.projects")}</a>
    <a class="button" href={href(lang, "cv-builder/")}>{t(lang, "hero.cv")}</a>
    <a class="button" href="https://github.com/Beratoguzhan620" rel="me">GitHub</a>
    <a class="button" href="https://www.linkedin.com/in/berat-oguzhan-turgut" rel="me">LinkedIn</a>
  </div>
</section>

<style>
  .hero {
    display: grid;
    gap: 16px;
    padding-top: 88px;
    padding-bottom: 80px;
  }
  .role {
    font: 400 14px/1.5 var(--mono);
    color: var(--text-muted);
  }
  h1 {
    font-size: clamp(36px, 7vw, 56px);
    letter-spacing: -0.01em;
  }
  .intro {
    max-width: 640px;
    font-size: 18px;
    line-height: 1.6;
    color: var(--text-muted);
  }
  .stats {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .stats li {
    padding: 6px 12px;
    border: 1px solid var(--border);
    border-radius: 999px;
    background: var(--surface);
    font: 500 13px/1.4 var(--mono);
  }
  .open {
    font-weight: 500;
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 8px;
  }
</style>
