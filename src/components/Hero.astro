---
import { href, type Lang, t } from "../i18n/ui";

const { lang } = Astro.props as { lang: Lang };
---

<section class="hero container" aria-labelledby="hero-title">
  <p class="role">{t(lang, "hero.role")}</p>
  <h1 id="hero-title">Berat Oğuzhan Turğut</h1>
  <p class="intro">{t(lang, "hero.intro")}</p>
  <div class="actions">
    <a class="button button--primary" href="#projects">{t(lang, "hero.projects")}</a>
    <a class="button" href={href(lang, "cv-builder/")}>{t(lang, "hero.cv")}</a>
    <a class="button" href="https://github.com/Beratoguzhan620" rel="me">GitHub</a>
  </div>
</section>

<style>
  .hero {
    display: grid;
    gap: 16px;
    padding-top: 88px;
    padding-bottom: 80px;
  }
  .role {
    font: 400 14px/1.5 var(--mono);
    color: var(--text-muted);
  }
  h1 {
    font-size: clamp(36px, 7vw, 56px);
    letter-spacing: -0.01em;
  }
  .intro {
    max-width: 640px;
    font-size: 18px;
    line-height: 1.6;
    color: var(--text-muted);
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 8px;
  }
</style>
