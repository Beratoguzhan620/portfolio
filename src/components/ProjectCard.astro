---
import { Image } from "astro:assets";

import type { Lang } from "../i18n/ui";
import { t } from "../i18n/ui";
import type { Project } from "../data/projects";

type Props = { project: Project; lang: Lang; eager?: boolean };
const { project, lang, eager = false } = Astro.props;
const alt = lang === "tr" ? `${project.name} ekran görüntüsü` : `${project.name} screenshot`;
---

<article class="card" data-category={project.category}>
  <div class:list={["shot", project.frame]}>
    <Image
      src={project.image}
      alt={alt}
      widths={project.frame === "phone" ? [180, 360] : [480, 720, 960]}
      sizes={project.frame === "phone" ? "180px" : "(max-width: 760px) 100vw, 480px"}
      loading={eager ? "eager" : "lazy"}
      format="webp"
      quality={78}
    />
  </div>
  <div class="body">
    <h3>{project.name}</h3>
    <p class="muted">{project.summary[lang]}</p>
    <ul class="stack" aria-label={lang === "tr" ? "Teknolojiler" : "Technologies"}>
      {project.stack.map((item) => <li class="tag">{item}</li>)}
    </ul>
    <div class="links">
      <a href={project.repo} aria-label={`${t(lang, "projects.code")}: ${project.name}`}>{t(lang, "projects.code")}</a>
      {project.demo ? (
        <a href={project.demo} aria-label={`${t(lang, "projects.demo")}: ${project.name}`}>{t(lang, "projects.demo")}</a>
      ) : (
        project.walkthrough && (
          <a href={project.walkthrough} aria-label={`${t(lang, "projects.walkthrough")}: ${project.name}`}>
            {t(lang, "projects.walkthrough")}
          </a>
        )
      )}
    </div>
  </div>
</article>

<style>
  .card {
    display: grid;
    grid-template-rows: auto 1fr;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius-card);
    overflow: hidden;
  }
  .card[hidden] {
    display: none;
  }
  .shot {
    aspect-ratio: 16 / 10;
    background: var(--surface-2);
    border-bottom: 1px solid var(--border);
    overflow: hidden;
  }
  .shot.screen img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top left;
  }
  .shot.phone {
    display: flex;
    justify-content: center;
    padding-top: 20px;
  }
  .shot.phone img {
    width: 46%;
    max-width: 180px;
    height: auto;
    align-self: flex-start;
    border-radius: 14px 14px 0 0;
    border: 1px solid var(--border);
    border-bottom: 0;
    box-shadow: var(--shadow);
  }
  .body {
    display: grid;
    align-content: start;
    gap: 12px;
    padding: 20px;
  }
  h3 {
    font-size: 18px;
  }
  .body p {
    font-size: 15px;
  }
  .stack {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .links {
    display: flex;
    gap: 16px;
    margin-top: 4px;
  }
  .links a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    font-weight: 500;
    color: var(--accent);
    text-underline-offset: 4px;
  }
</style>
