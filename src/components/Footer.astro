---
import { type Lang, t } from "../i18n/ui";

const { lang } = Astro.props as { lang: Lang };
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container row">
    <p>© {year} Berat Oğuzhan Turğut</p>
    <p class="muted">{t(lang, "footer.built")}</p>
  </div>
</footer>

<style>
  .site-footer {
    border-top: 1px solid var(--border);
    padding: 24px 0;
    font-size: 14px;
  }
  .row {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 8px;
  }
</style>
